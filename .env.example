# Variables del servidor de notificaciones (funciones de Vercel en /api).
# Configúralas en Vercel → Project → Settings → Environment Variables.
# Para `vercel dev` en local, cópialas a un archivo .env (que NO se sube a git).

# Upstash Redis (consola de Upstash → tu base de datos → REST API).
# Si conectas Redis con la integración de Vercel (Storage), crea KV_REST_API_URL y
# KV_REST_API_TOKEN: también valen, no hace falta duplicarlas.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash QStash (consola de Upstash → QStash → Request / Signing Keys)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Solo si tu QStash está en una región concreta (p. ej. https://qstash-eu-central-1.upstash.io)
# QSTASH_URL=

# Claves VAPID para Web Push. Genéralas una sola vez con:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto para los servicios push (mailto: o https:)
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# URL pública de la app (a la que QStash llama). En Vercel se deduce sola de
# VERCEL_PROJECT_PRODUCTION_URL; ponla solo si usas un dominio propio.
# APP_URL=https://tu-app.vercel.app
