rules_version = '2';

// Reglas de Firestore de Ciclita. Cada cuenta solo puede leer y escribir lo suyo
// (users/{uid} y sus subcolecciones), y solo con la forma y los tamaños que usa la
// app: así nadie puede llenar la base de datos con otra cosa. Lo demás está cerrado.
// Se publican en Firebase → Firestore Database → Reglas.
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function data() {
      return request.resource.data;
    }
    // Campo opcional: si está, es un texto de como mucho `max` caracteres.
    function optText(field, max) {
      return !(field in data()) || (data()[field] is string && data()[field].size() <= max);
    }
    function optNumber(field) {
      return !(field in data()) || data()[field] is number;
    }
    function optList(field, max) {
      return !(field in data()) || (data()[field] is list && data()[field].size() <= max);
    }
    function isDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    // Campos que pone la sincronización en todos los documentos.
    function syncFields() {
      return data().updatedAt is number && (!('syncedAt' in data()) || data().syncedAt is timestamp);
    }

    match /users/{uid} {
      // Perfil y consentimientos (registro).
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && data().keys().hasOnly(['firstName', 'lastName', 'birthDate', 'country', 'marketing',
            'privacyAcceptedAt', 'healthConsentAt', 'privacyVersion', 'createdAt'])
        && optText('firstName', 60) && optText('lastName', 60) && optText('country', 10)
        && optText('privacyVersion', 20)
        && (!('birthDate' in data()) || isDate(data().birthDate))
        && (!('marketing' in data()) || data().marketing is bool);

      // Un documento por día con registro.
      match /days/{date} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && isDate(date) && data().date == date && syncFields()
          && data().keys().hasOnly(['date', 'flow', 'symptoms', 'moods', 'mood', 'pain', 'medication',
              'notes', 'temperature', 'mucus', 'sex', 'weight', 'pillTaken', 'ovulationTest', 'pregnancyTest',
              'systolic', 'diastolic', 'pulse', 'updatedAt', 'syncedAt', 'deleted'])
          && optText('flow', 20) && optList('symptoms', 100) && optList('moods', 20) && optText('mood', 20)
          && optNumber('pain') && optText('medication', 200) && optText('notes', 2000)
          && optNumber('temperature') && optText('mucus', 20) && optText('sex', 20) && optNumber('weight')
          && (!('pillTaken' in data()) || data().pillTaken is bool)
          && optText('ovulationTest', 20) && optText('pregnancyTest', 20)
          && optNumber('systolic') && optNumber('diastolic') && optNumber('pulse')
          && (!('deleted' in data()) || data().deleted is bool);
      }

      // Citas médicas.
      match /appointments/{id} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && id.size() <= 64 && data().id == id && syncFields()
          && data().keys().hasOnly(['id', 'type', 'date', 'time', 'title', 'place', 'notes', 'reminder',
              'updatedAt', 'syncedAt', 'deleted'])
          && optText('type', 20) && (!('date' in data()) || isDate(data().date))
          && (!('time' in data()) || data().time == null || (data().time is string && data().time.size() <= 5))
          && optText('title', 80) && optText('place', 120) && optText('notes', 4000)
          && (!('reminder' in data()) || data().reminder == null || data().reminder is map)
          && (!('deleted' in data()) || data().deleted is bool);
      }

      // Periodos, ajustes y síntomas personalizados (un documento cada uno).
      match /state/{name} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && syncFields() && (
          (name == 'periods' && data().keys().hasOnly(['list', 'updatedAt', 'syncedAt'])
            && data().list is list && data().list.size() <= 1000)
          || (name == 'settings' && data().keys().hasOnly(['values', 'updatedAt', 'syncedAt'])
            && data().values is map && data().values.keys().size() <= 40)
          || (name == 'symptoms' && data().keys().hasOnly(['custom', 'updatedAt', 'syncedAt'])
            && data().custom is list && data().custom.size() <= 200)
        );
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
